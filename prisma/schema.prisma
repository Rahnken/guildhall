generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// The one guild this site serves. Created by the first upload, which also
/// fixes which in-game guild later uploads must be for.
model Guild {
  id         Int       @id @default(1)
  name       String
  realm      String
  faction    String    @default("")
  rosterAt   DateTime?
  rosterBy   String    @default("")
  bankCopper BigInt?
}

/// A guild member's character, replaced from each roster upload.
model Character {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  rank            String   @default("")
  rankIndex       Int      @default(0)
  level           Int      @default(0)
  classToken      String   @default("")
  zone            String   @default("")
  note            String   @default("")
  online          Boolean  @default(false)
  /// Hours since last seen when the roster was captured; null while online.
  lastOnlineHours Int?
  firstSeen       DateTime @default(now())
  /// Who says this character is theirs. Kept across roster uploads; gone
  /// when the character leaves the guild.
  memberId        String?
  member          Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  /// The one character its member is known by; their others are alts.
  main            Boolean  @default(false)
  professions     Profession[]

  @@index([memberId])
}

/// A profession a character has, as their Guildhall addon last saw it.
model Profession {
  id          Int           @id @default(autoincrement())
  characterId Int
  character   Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  name        String
  skill       Int
  maxSkill    Int
  scannedAt   DateTime
  recipes     KnownRecipe[]

  @@unique([characterId, name])
  @@index([name])
}

/// A recipe from src/data/recipes.json that a character knows.
model KnownRecipe {
  professionId Int
  profession   Profession @relation(fields: [professionId], references: [id], onDelete: Cascade)
  spellId      Int

  @@id([professionId, spellId])
  @@index([spellId])
}

/// Someone who has signed in with Discord. The id is their Discord user id.
model Member {
  id         String      @id
  name       String
  characters Character[]
}

model BankTab {
  index     Int        @id
  name      String
  scannedAt DateTime
  items     BankItem[]
}

model BankItem {
  id       Int     @id @default(autoincrement())
  tabIndex Int
  tab      BankTab @relation(fields: [tabIndex], references: [index], onDelete: Cascade)
  slot     Int
  itemId   Int
  name     String
  count    Int

  @@unique([tabIndex, slot])
  @@index([name])
}

/// One row per upload, for the officers' sync history.
model SyncLog {
  id         Int      @id @default(autoincrement())
  receivedAt DateTime @default(now())
  uploadedBy String
  summary    String
}

/// What the public page says. Officers edit it on the Settings page; until
/// they do, GUILD_NAME, GUILD_TAGLINE and DISCORD_INVITE_URL apply.
model SiteSettings {
  id          Int    @id @default(1)
  name        String
  description String @default("")
  inviteUrl   String @default("")
}
