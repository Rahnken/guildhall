{
  "name": "guildhall",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node scripts/zip-addon.mjs && dotenv -e .env.local -- vite dev --port 3000",
    "build": "node scripts/zip-addon.mjs && vite build",
    "start": "node .output/server/index.mjs",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "addon:install": "dotenv -e .env.local -- node scripts/install-addon.mjs",
    "sync": "dotenv -e .env.local -- tsx scripts/sync.ts",
    "icons:ids": "tsx scripts/icons.ts ids",
    "emblem:build": "dotenv -e .env.local -- tsx scripts/emblem.ts",
    "icons:build": "dotenv -e .env.local -- tsx scripts/icons.ts build",
    "icons:read": "dotenv -e .env.local -- tsx scripts/icons.ts read",
    "sync:watch": "dotenv -e .env.local -- tsx scripts/sync.ts --watch",
    "recipes:import": "dotenv -e .env.local -- node scripts/import-recipes.mjs",
    "discord:register": "dotenv -e .env.local -- tsx scripts/register-commands.mjs",
    "lint": "eslint src scripts tests",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:addon": "node tests/addon.test.mjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "nitro": "3.0.260610-beta",
    "prisma": "^7.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "0.5.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.20.0",
    "fengari": "^0.1.5",
    "prettier": "^3.8.1",
    "sharp": "^0.35.5",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
