generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// The one guild this site serves. Created by the first upload, which also
/// fixes which in-game guild later uploads must be for.
model Guild {
  id         Int       @id @default(1)
  name       String
  realm      String
  faction    String    @default("")
  rosterAt   DateTime?
  rosterBy   String    @default("")
  bankCopper BigInt?
}

/// A guild member's character, replaced from each roster upload.
model Character {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  rank            String   @default("")
  rankIndex       Int      @default(0)
  level           Int      @default(0)
  classToken      String   @default("")
  zone            String   @default("")
  note            String   @default("")
  online          Boolean  @default(false)
  /// Hours since last seen when the roster was captured; null while online.
  lastOnlineHours Int?
  firstSeen       DateTime @default(now())
  /// Who says this character is theirs. Kept across roster uploads; gone
  /// when the character leaves the guild.
  memberId        String?
  member          Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  /// The one character its member is known by; their others are alts.
  main            Boolean  @default(false)
  professions     Profession[]
  signups         EventSignup[]

  @@index([memberId])
}

/// A profession a character has, as their Guildhall addon last saw it.
model Profession {
  id          Int           @id @default(autoincrement())
  characterId Int
  character   Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  name        String
  skill       Int
  maxSkill    Int
  scannedAt   DateTime
  recipes     KnownRecipe[]

  @@unique([characterId, name])
  @@index([name])
}

/// A recipe from src/data/recipes.json that a character knows.
model KnownRecipe {
  professionId Int
  profession   Profession @relation(fields: [professionId], references: [id], onDelete: Cascade)
  spellId      Int

  @@id([professionId, spellId])
  @@index([spellId])
}

/// Someone who has signed in with Discord. The id is their Discord user id.
model Member {
  id         String         @id
  name       String
  characters Character[]
  requested  CraftRequest[] @relation("requested")
  asked      CraftRequest[] @relation("asked")
  crafting   CraftRequest[] @relation("crafting")
  signups    EventSignup[]
}

/// Something a member has asked the guild's crafters to make.
model CraftRequest {
  id           Int      @id @default(autoincrement())
  /// The recipe, from src/data/recipes.json.
  spellId      Int
  quantity     Int      @default(1)
  /// The requester's character to send it to.
  deliverTo    String   @default("")
  /// Whether the requester will send the materials.
  hasMaterials Boolean  @default(false)
  note         String   @default("")
  /// open, accepted (someone is making it), done or cancelled.
  status       String   @default("open")
  requesterId  String
  requester    Member   @relation("requested", fields: [requesterId], references: [id], onDelete: Cascade)
  /// The crafter it was addressed to, if the requester picked one.
  askedId      String?
  asked        Member?  @relation("asked", fields: [askedId], references: [id], onDelete: SetNull)
  /// Who is making it, or made it.
  crafterId    String?
  crafter      Member?  @relation("crafting", fields: [crafterId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

/// Something the guild is doing together, set up by an officer.
model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @default("")
  startsAt    DateTime
  /// The time zone of the officer who set the time. A weekly event stays at
  /// the same hour on their clock when the clocks change.
  timeZone    String   @default("UTC")
  /// Weekly. Only the next occurrence has this set: once it starts, a copy
  /// a week later takes the flag over (src/server/events.server.ts).
  repeats     Boolean  @default(false)
  cancelled   Boolean  @default(false)
  createdBy   String   @default("")
  createdAt   DateTime @default(now())
  signups     EventSignup[]

  @@index([startsAt])
}

/// A member's answer to one event: which character, in which role.
model EventSignup {
  id          Int       @id @default(autoincrement())
  eventId     Int
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId    String
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// Gone with the character if it leaves the guild.
  characterId Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  /// going, maybe or out.
  reply       String
  /// tank, healer or damage.
  role        String
  note        String    @default("")
  updatedAt   DateTime  @updatedAt

  @@unique([eventId, memberId])
  @@index([characterId])
}

model BankTab {
  index     Int        @id
  name      String
  scannedAt DateTime
  items     BankItem[]
}

model BankItem {
  id       Int     @id @default(autoincrement())
  tabIndex Int
  tab      BankTab @relation(fields: [tabIndex], references: [index], onDelete: Cascade)
  slot     Int
  itemId   Int
  name     String
  count    Int

  @@unique([tabIndex, slot])
  @@index([name])
}

/// One row per upload, for the officers' sync history.
model SyncLog {
  id         Int      @id @default(autoincrement())
  receivedAt DateTime @default(now())
  uploadedBy String
  summary    String
}

/// What the public page says. Officers edit it on the Settings page; until
/// they do, GUILD_NAME, GUILD_TAGLINE and DISCORD_INVITE_URL apply.
model SiteSettings {
  id          Int    @id @default(1)
  name        String
  description String @default("")
  inviteUrl   String @default("")
  /// The guild tabard's colours as "#rrggbb"; the site's colour scheme is
  /// made from them. Empty keeps the site's own colours.
  colorBackground String @default("")
  colorBorder     String @default("")
  colorEmblem     String @default("")
}
