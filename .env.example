# ---- Site ----
DATABASE_URL="file:./dev.db"
PUBLIC_URL="http://localhost:3000"
# At least 32 random characters. Make one with: openssl rand -hex 32
SESSION_SECRET=""
GUILD_NAME="Guildhall"
GUILD_TAGLINE=""
# "Request to join" on the public page goes here
DISCORD_INVITE_URL=""

# ---- Discord application (discord.com/developers/applications) ----
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_PUBLIC_KEY=""
# Only needed by `npm run discord:register`
DISCORD_BOT_TOKEN=""
# The guild's Discord server; its members can sign in
DISCORD_GUILD_ID=""
# Optional, comma separated role ids: if set, signing in needs one of these roles
DISCORD_MEMBER_ROLE_IDS=""
# Comma separated role ids that count as officers
DISCORD_OFFICER_ROLE_IDS=""
# Optional channel webhook for "joined / left / levelled up" posts
DISCORD_WEBHOOK_URL=""

# ---- Uploads ----
# name:token pairs, comma separated; each token at least 24 characters
INGEST_TOKENS=""
# Local development only: "Member sign in" signs you in as an officer without Discord
DEV_LOGIN="1"

# ---- Sync script (your own PC) ----
SITE_URL="http://localhost:3000"
INGEST_TOKEN=""
# Your _forever_ folder, if not in the default install path
WOW_FOREVER_DIR=""
# WTF account folder, if you have more than one
WOW_ACCOUNT=""
